{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:f1-cache-replay:schema:replay-data:v2:chunk",
  "title":"Browser delivery v2 chunk",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","fixtureId","chunkId","sequence","startMs","endMs","overlap","timeMs","authoritativeStartIndex","drivers","leaderboardOrder","trackStatusCode","weatherState","events"],
  "$defs":{
    "time":{"type":"integer","minimum":0,"maximum":9223372036854775807},"id":{"type":"string","pattern":"^[A-Z0-9]{2,4}$"},
    "n":{"type":["number","null"]},"nn":{"type":["number","null"],"minimum":0},"i":{"type":["integer","null"]},"b":{"type":["boolean","null"]},"s":{"type":["string","null"]},
    "range":{"type":"object","additionalProperties":false,"required":["startMs","endMs"],"properties":{"startMs":{"$ref":"#/$defs/time"},"endMs":{"$ref":"#/$defs/time"}}},
    "columns":{"type":"object","additionalProperties":false,"required":["x","y","trackDistanceMeters","speed","throttle","brake","gapToLeaderMs","lap","position","gear","drs","tyreCompound","status","isInPitLane"],"properties":{"x":{"type":"array","items":{"$ref":"#/$defs/n"}},"y":{"type":"array","items":{"$ref":"#/$defs/n"}},"trackDistanceMeters":{"type":"array","items":{"$ref":"#/$defs/nn"}},"speed":{"type":"array","items":{"$ref":"#/$defs/n"}},"rpm":{"type":"array","items":{"$ref":"#/$defs/n"}},"throttle":{"type":"array","items":{"$ref":"#/$defs/n"}},"brake":{"type":"array","items":{"$ref":"#/$defs/i"}},"gapToLeaderMs":{"type":"array","items":{"$ref":"#/$defs/nn"}},"lap":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/i"},{"minimum":1}]}},"position":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/i"},{"minimum":1}]}},"gear":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/i"},{"minimum":0},{"maximum":8}]}},"drs":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/i"},{"minimum":0}]}},"tyreCompound":{"type":"array","items":{"$ref":"#/$defs/s"}},"tyreAge":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/i"},{"minimum":0}]}},"status":{"type":"array","items":{"$ref":"#/$defs/s"}},"isInPitLane":{"type":"array","items":{"$ref":"#/$defs/b"}},"isFinished":{"type":"array","items":{"$ref":"#/$defs/b"}}}},
    "event":{"type":"object","additionalProperties":false,"required":["sessionTimeMs","eventType","description"],"properties":{"sessionTimeMs":{"$ref":"#/$defs/time"},"eventType":{"type":"string","minLength":1},"driverId":{"type":["string","null"],"pattern":"^[A-Z0-9]{2,4}$"},"description":{"type":"string","minLength":1},"payload":{"type":"object"}}}
  },
  "properties":{
    "contractVersion":{"const":"v2"},"fixtureId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"chunkId":{"type":"string","pattern":"^chunk-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})$"},"sequence":{"type":"integer","minimum":1,"maximum":9223372036854775807},"startMs":{"$ref":"#/$defs/time"},"endMs":{"$ref":"#/$defs/time"},
    "overlap":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","previousChunkPath","range","authoritativeFromMs"],"properties":{"kind":{"const":"none"},"previousChunkPath":{"type":"null"},"range":{"type":"null"},"authoritativeFromMs":{"type":"null"}}},{"type":"object","additionalProperties":false,"required":["kind","previousChunkPath","range","authoritativeFromMs"],"properties":{"kind":{"const":"handoff"},"previousChunkPath":{"type":"string"},"range":{"$ref":"#/$defs/range"},"authoritativeFromMs":{"$ref":"#/$defs/time"}}}]},
    "timeMs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/time"}},"authoritativeStartIndex":{"type":"integer","minimum":0},"drivers":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/id"},"additionalProperties":{"$ref":"#/$defs/columns"}},"leaderboardOrder":{"type":"array","items":{"oneOf":[{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},{"type":"null"}]}},"trackStatusCode":{"type":"array","items":{"type":["integer","null"],"minimum":0}},"weatherState":{"type":"array","items":{"type":["string","null"]}},"events":{"type":"array","items":{"$ref":"#/$defs/event"}}
  }
}
