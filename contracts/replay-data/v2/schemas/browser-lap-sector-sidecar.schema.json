{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:f1-cache-replay:schema:replay-data:v2:browser-lap-sector-sidecar",
  "title":"Browser delivery v2 lap-sector sidecar","$comment":"Optional aligned per-driver lapKind column: flying|outlap|inlap|unknown. An absent column means the capability is unavailable and consumers must fail closed (no lap may be treated as flying). When present, the array is aligned to the other per-driver columns (same length, same order); every element is one of the four values, with unknown as the fail-closed value for insufficient source evidence. Alignment length is validated by the delivering model and by later implementation.","type":"object","additionalProperties":false,"required":["contractVersion","fixtureId","phaseBoundaries","drivers"],
  "$defs":{"driver":{"type":"string","pattern":"^[A-Z0-9]{2,4}$"},"phase":{"type":["string","null"],"enum":["Q1","Q2","Q3",null]},"time":{"type":"integer","minimum":0,"maximum":9223372036854775807},"nullableTime":{"type":["integer","null"],"minimum":0,"maximum":9223372036854775807},"lap":{"type":"integer","minimum":1},"nullableDuration":{"type":["integer","null"],"minimum":0,"maximum":9223372036854775807},"lapKind":{"enum":["flying","outlap","inlap","unknown"]},"boundary":{"type":"object","additionalProperties":false,"required":["phase","startMs"],"properties":{"phase":{"type":"string","enum":["Q1","Q2","Q3"]},"startMs":{"$ref":"#/$defs/time"}}},"columns":{"type":"object","additionalProperties":false,"required":["lapNumber","lapStartMs","lapEndMs","lapDurationMs","sector1DurationMs","sector2DurationMs","sector3DurationMs","sector1SessionTimeMs","sector2SessionTimeMs","sector3SessionTimeMs","qualifyingPhase"],"properties":{"lapNumber":{"type":"array","items":{"$ref":"#/$defs/lap"}},"lapStartMs":{"type":"array","items":{"$ref":"#/$defs/time"}},"lapEndMs":{"type":"array","items":{"$ref":"#/$defs/time"}},"lapDurationMs":{"type":"array","items":{"$ref":"#/$defs/nullableDuration"}},"sector1DurationMs":{"type":"array","items":{"$ref":"#/$defs/nullableDuration"}},"sector2DurationMs":{"type":"array","items":{"$ref":"#/$defs/nullableDuration"}},"sector3DurationMs":{"type":"array","items":{"$ref":"#/$defs/nullableDuration"}},"sector1SessionTimeMs":{"type":"array","items":{"$ref":"#/$defs/nullableTime"}},"sector2SessionTimeMs":{"type":"array","items":{"$ref":"#/$defs/nullableTime"}},"sector3SessionTimeMs":{"type":"array","items":{"$ref":"#/$defs/nullableTime"}},"qualifyingPhase":{"type":"array","items":{"$ref":"#/$defs/phase"}},"lapKind":{"type":"array","items":{"$ref":"#/$defs/lapKind"}}}},"reference":{"type":"object","additionalProperties":false,"required":["path","schemaId","sha256"],"properties":{"path":{"const":"lap-sector-sidecar.json"},"schemaId":{"const":"urn:f1-cache-replay:schema:replay-data:v2:browser-lap-sector-sidecar"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
  "properties":{"contractVersion":{"const":"v2"},"fixtureId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"phaseBoundaries":{"type":"array","items":{"$ref":"#/$defs/boundary"}},"drivers":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/driver"},"additionalProperties":{"$ref":"#/$defs/columns"}}}
