  "properties":{"contractVersion":{"const":"v2"},"fixtureId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"drivers":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/driver"},"additionalProperties":{"$ref":"#/$defs/columns"}}}
