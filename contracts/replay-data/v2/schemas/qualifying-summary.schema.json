{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:f1-cache-replay:schema:replay-data:v2:qualifying-summary",
  "title":"Browser delivery v2 qualifying summary","type":"object","additionalProperties":false,"required":["contractVersion","fixtureId","drivers"],
  "$comment":"Every driver column is required to have the same length; the immutable Python model performs the cross-column check.",
  "$defs":{"driver":{"type":"string","pattern":"^[A-Z0-9]{2,4}$"},"time":{"type":["integer","null"],"minimum":0,"maximum":9223372036854775807},"position":{"type":["integer","null"],"minimum":1},"lap":{"type":["integer","null"],"minimum":1},"columns":{"type":"object","additionalProperties":false,"required":["qualifyingPosition","q1TimeMs","q2TimeMs","q3TimeMs","bestLapNumber","bestLapTimeMs"],"properties":{"qualifyingPosition":{"type":"array","items":{"$ref":"#/$defs/position"}},"q1TimeMs":{"type":"array","items":{"$ref":"#/$defs/time"}},"q2TimeMs":{"type":"array","items":{"$ref":"#/$defs/time"}},"q3TimeMs":{"type":"array","items":{"$ref":"#/$defs/time"}},"bestLapNumber":{"type":"array","items":{"$ref":"#/$defs/lap"}},"bestLapTimeMs":{"type":"array","items":{"$ref":"#/$defs/time"}}}},"reference":{"type":"object","additionalProperties":false,"required":["path","schemaId","sha256"],"properties":{"path":{"const":"qualifying-summary.json"},"schemaId":{"const":"urn:f1-cache-replay:schema:replay-data:v2:qualifying-summary"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
  "properties":{"contractVersion":{"const":"v2"},"fixtureId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"drivers":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/driver"},"additionalProperties":{"$ref":"#/$defs/columns"}}}
}
