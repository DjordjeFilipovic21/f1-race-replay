{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:f1-cache-replay:schema:replay-data:v1:manifest",
  "title": "Replay fixture manifest",
  "description": "Schema for the top-level offline replay fixture manifest in the Phase 0 v1 replay contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "fixtureId",
    "fixtureName",
    "schemas",
    "trackAssets",
    "chunks",
    "drivers"
  ],
  "$defs": {
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "teamName",
        "colorHex",
        "carNumber"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,4}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "teamName": {
          "type": "string",
          "minLength": 1
        },
        "colorHex": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "carNumber": {
          "type": "string",
          "pattern": "^[0-9]{1,2}$"
        }
      }
    },
    "seasonMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        }
      }
    },
    "telemetryCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drs",
        "overtakeMode",
        "activeAero",
        "ersReplacement"
      ],
      "properties": {
        "drs": {
          "enum": [
            "available",
            "not-published"
          ]
        },
        "overtakeMode": {
          "enum": [
            "available",
            "not-published"
          ]
        },
        "activeAero": {
          "enum": [
            "available",
            "not-published"
          ]
        },
        "ersReplacement": {
          "enum": [
            "available",
            "not-published"
          ]
        }
      }
    }
  },
  "properties": {
    "contractVersion": {
      "const": "v1"
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fixtureName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "seasonMetadata": {
      "$ref": "#/$defs/seasonMetadata"
    },
    "telemetryCapabilities": {
      "$ref": "#/$defs/telemetryCapabilities"
    },
    "formatVersion": {
      "const": "browser-delivery-v1"
    },
    "deliveryVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceGenerationId": {
      "type": "string",
      "minLength": 1
    },
    "sourceManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "chunk",
        "trackAssets"
      ],
      "properties": {
        "manifest": {
          "const": "urn:f1-cache-replay:schema:replay-data:v1:manifest"
        },
        "chunk": {
          "const": "urn:f1-cache-replay:schema:replay-data:v1:chunk"
        },
        "trackAssets": {
          "const": "urn:f1-cache-replay:schema:replay-data:v1:track-assets"
        }
      }
    },
    "trackAssets": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:track-assets#/$defs/trackAssetsFileReference"
    },
    "timelineSummary": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:timeline-summary#/$defs/timelineSummaryFileReference"
    },
    "lapSectorSidecar": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:browser-lap-sector-sidecar#/$defs/browserLapSectorSidecarFileReference"
    },
    "penaltySidecar": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:penalty-sidecar#/$defs/penaltySidecarFileReference"
    },
    "stintSummary": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:stint-summary#/$defs/stintSummaryFileReference"
    },
    "pitLossModel": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:pit-loss-model#/$defs/pitLossModelFileReference"
    },
    "weatherSidecar": {
      "$ref": "urn:f1-cache-replay:schema:replay-data:v1:weather-sidecar#/$defs/weatherSidecarFileReference"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:f1-cache-replay:schema:replay-data:v1:chunk#/$defs/chunkFileReference"
      }
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/driver"
      }
    },
    "lapStarts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lap", "startMs"],
        "properties": {
          "lap": {"type": "integer", "minimum": 1},
          "startMs": {"type": "integer", "minimum": 0}
        }
      }
    },
    "goldenSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "const": "golden-snapshots.json"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
